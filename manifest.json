{
  "manifest_version": 3,
  "name": "TradeVision AI",
  "version": "0.1.0",
  "description": "Local-first, AI-assisted market analysis and paper-trading research. Analysis, backtesting, and evaluation only — no real-money execution and no platform automation.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TradeVision AI"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
